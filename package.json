{
	"name": "wms_backend",
	"version": "1.0.0",
	"description": "RESTful API for warehouse management system",
	"author": "quanghiep03198",
	"private": true,
	"license": "GreenLand",
	"scripts": {
		"build": "nest build && npm run sentry:sourcemaps",
		"format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
		"start": "nest start",
		"start:dev": "nest start -b swc --watch",
		"start:debug": "nest start -b swc --debug --watch",
		"start:prod": "node dist/main",
		"compodoc": "npx @compodoc/compodoc -p tsconfig.json -s --port 3003 -d ./.compodoc",
		"pm2:start": "pm2 start ecosystem.config.js",
		"lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:cov": "jest --coverage",
		"test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
		"test:e2e": "jest --config ./test/jest-e2e.json",
		"prepare": "husky",
		"typeorm": "SET MIGRATION_DB_HOST=%npm_config_host% && ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli",
		"migration:show": "npm run typeorm migration:show -- -d ./src/databases/data-source.ts",
		"migration:create": "npm run typeorm migration:create ./src/databases/migrations/%npm_config_name%",
		"migration:run": "npm run typeorm migration:run -- -d src/databases/data-source.ts",
		"migration:revert": "npm run typeorm migration:revert -- -d ./src/databases/data-source.ts",
		"seed:run": "SET SEEDING_DB_HOST=%npm_config_host% && ts-node -r tsconfig-paths/register src/databases/seed.ts",
		"seed:create": "npx ts-node -r tsconfig-paths/register ./node_modules/typeorm-extension/bin/cli.cjs seed:create --name src/databases/seeds/%npm_config_name%.seeder.ts",
		"sentry:sourcemaps": "sentry-cli sourcemaps inject --org scyllas --project wms-be-nest ./dist && sentry-cli sourcemaps upload --org scyllas --project wms-be-nest ./dist"
	},
	"dependencies": {
		"@blazity/nest-file-fastify": "^1.0.0",
		"@faker-js/faker": "^9.9.0",
		"@fastify/compress": "^8.3.1",
		"@fastify/cookie": "^11.0.2",
		"@fastify/helmet": "^13.0.2",
		"@fastify/multipart": "^9.4.0",
		"@keyv/redis": "^4.6.0",
		"@nestjs/axios": "^4.0.1",
		"@nestjs/bullmq": "^11.0.4",
		"@nestjs/cache-manager": "^3.1.2",
		"@nestjs/common": "^11.1.24",
		"@nestjs/config": "^4.0.4",
		"@nestjs/core": "^11.1.24",
		"@nestjs/event-emitter": "^3.1.0",
		"@nestjs/jwt": "^11.0.2",
		"@nestjs/mapped-types": "^2.1.1",
		"@nestjs/mongoose": "^11.0.4",
		"@nestjs/passport": "^11.0.5",
		"@nestjs/platform-fastify": "^11.1.24",
		"@nestjs/platform-socket.io": "^11.1.24",
		"@nestjs/schedule": "^6.1.3",
		"@nestjs/throttler": "^6.5.0",
		"@nestjs/typeorm": "^11.0.1",
		"@nestjs/websockets": "^11.1.24",
		"@sentry/cli": "^3.4.3",
		"@sentry/nestjs": "^10.55.0",
		"@sentry/profiling-node": "^10.55.0",
		"@willsoto/nestjs-prometheus": "^6.1.0",
		"axios": "^1.16.1",
		"bcrypt": "^5.1.1",
		"body-parser": "^1.20.5",
		"bullmq": "^5.77.6",
		"cache-manager": "^7.2.8",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.15.1",
		"csv-parser": "^3.2.1",
		"date-fns": "^3.6.0",
		"dotenv": "^16.6.1",
		"exceljs": "^4.4.0",
		"fastify": "^5.8.5",
		"fastify-sse": "^1.0.0",
		"flat": "^6.0.1",
		"fs-extra": "^11.3.5",
		"ioredis": "^5.11.0",
		"lodash": "^4.18.1",
		"lz-string": "^1.5.0",
		"mongoose": "^8.24.0",
		"mongoose-delete": "^1.0.7",
		"mongoose-paginate-v2": "^1.9.4",
		"morgan": "^1.10.1",
		"mssql": "^10.0.4",
		"nestjs-i18n": "^10.8.4",
		"nestjs-pino": "^4.6.1",
		"passport": "^0.7.0",
		"passport-jwt": "^4.0.1",
		"passport-local": "^1.0.0",
		"pino-loki": "^2.6.0",
		"pino-pretty": "^13.1.3",
		"prom-client": "^15.1.3",
		"redis": "^5.12.1",
		"reflect-metadata": "^0.2.2",
