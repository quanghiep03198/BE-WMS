		"socket.io": "^4.8.3",
		"typeorm": "^0.3.30",
		"typeorm-extension": "^3.9.0",
		"util": "^0.12.5",
		"zod": "^3.25.76"
	},
	"devDependencies": {
		"@automock/adapters.nestjs": "^2.1.0",
		"@automock/jest": "^2.1.2",
		"@commitlint/cli": "^19.8.1",
		"@commitlint/config-conventional": "^19.8.1",
		"@compodoc/compodoc": "^1.2.1",
		"@nestjs/cli": "^11.0.21",
		"@nestjs/schematics": "^11.1.0",
		"@nestjs/testing": "^11.1.24",
		"@swc/cli": "^0.7.10",
		"@swc/core": "^1.15.40",
		"@swc/jest": "^0.2.39",
		"@types/bcrypt": "^5.0.2",
		"@types/fs-extra": "^11.0.4",
		"@types/jest": "^29.5.14",
		"@types/lodash": "^4.17.24",
		"@types/mongoose-delete": "^1.0.6",
		"@types/morgan": "^1.9.10",
		"@types/multer": "^1.4.13",
		"@types/node": "^20.19.41",
		"@types/supertest": "^6.0.3",
		"@typescript-eslint/eslint-plugin": "^8.60.0",
		"@typescript-eslint/parser": "^8.60.0",
		"eslint": "^8.57.1",
		"eslint-config-prettier": "^9.1.2",
		"eslint-plugin-prettier": "^5.5.6",
		"eslint-plugin-unused-imports": "^4.4.1",
		"husky": "^9.1.7",
		"jest": "^29.7.0",
		"lint-staged": "^15.5.2",
		"prettier": "^3.8.3",
		"prettier-plugin-organize-imports": "^4.3.0",
		"source-map-support": "^0.5.21",
		"supertest": "^7.2.2",
		"ts-jest": "^29.4.11",
		"ts-loader": "^9.6.0",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^5.9.3"
	},
	"jest": {
		"transform": {
			"^.+\\.(t|j)s?$": [
				"@swc/jest"
			]
		}
	},
	"lint-staged": {
		"*.ts": [
			"npm run lint",
			"npm run format",
			"git add ."
		]
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"@automock/adapters.nestjs",
			"@compodoc/compodoc",
			"@nestjs/core",
			"@sentry-internal/node-cpu-profiler",
			"@sentry/cli",
			"@sentry/profiling-node",
			"@swc/core",
			"bcrypt",
			"msgpackr-extract",
			"nestjs-pino",
			"protobufjs"
		]
	}
}
