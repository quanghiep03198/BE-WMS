		"typescript": "^5.8.3"
	},
	"jest": {
		"transform": {
			"^.+\\.(t|j)s?$": [
				"@swc/jest"
			]
		}
	},
	"lint-staged": {
		"*.ts": [
			"npm run lint",
			"npm run format",
			"git add ."
		]
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"@automock/adapters.nestjs",
			"@nestjs/core",
			"@sentry/cli",
			"@sentry/profiling-node",
			"@swc/core",
			"bcrypt",
			"msgpackr-extract",
			"nestjs-pino",
			"protobufjs"
		]
	}
}
