		"eslint-config-prettier": "^9.0.0",
		"eslint-plugin-prettier": "^5.0.0",
		"eslint-plugin-unused-imports": "^4.1.3",
		"husky": "^9.1.5",
		"jest": "^29.7.0",
		"lint-staged": "^15.2.10",
		"prettier": "^3.0.0",
		"prettier-plugin-organize-imports": "^4.0.0",
		"run-script-webpack-plugin": "^0.2.0",
		"source-map-support": "^0.5.21",
		"supertest": "^7.0.0",
