{
	"name": "wms-api",
	"version": "1.0.0",
	"description": "RESTful API for warehouse management system",
	"author": "quanghiep03198",
	"private": true,
	"license": "UNLICENSED",
	"scripts": {
		"build": "nest build && npm run sentry:sourcemaps",
		"format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
		"start": "nest start",
		"start:dev": "nest start -b swc --watch",
		"start:debug": "nest start -b swc --debug --watch",
		"start:prod": "node dist/main",
		"pm2:start": "pm2 start ecosystem.config.js",
		"lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:cov": "jest --coverage",
		"test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
		"test:e2e": "jest --config ./test/jest-e2e.json",
		"prepare": "husky",
		"typeorm": "SET MIGRATION_DB_HOST=%npm_config_host% && ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli",
		"migration:show": "npm run typeorm migration:show -- -d ./src/databases/data-source.ts",
		"migration:create": "npm run typeorm migration:create ./src/databases/migrations/%npm_config_name%",
		"migration:run": "npm run typeorm migration:run -- -d src/databases/data-source.ts",
		"migration:revert": "npm run typeorm migration:revert -- -d ./src/databases/data-source.ts",
		"seed:run": "SET SEEDING_DB_HOST=%npm_config_host% && ts-node -r tsconfig-paths/register src/databases/seed.ts",
		"seed:create": "npx ts-node -r tsconfig-paths/register ./node_modules/typeorm-extension/bin/cli.cjs seed:create --name src/databases/seeds/%npm_config_name%.seeder.ts",
		"sentry:sourcemaps": "sentry-cli sourcemaps inject --org scyllas --project wms-be-nest ./dist && sentry-cli sourcemaps upload --org scyllas --project wms-be-nest ./dist"
	},
	"dependencies": {
		"@blazity/nest-file-fastify": "^1.0.0",
		"@faker-js/faker": "^9.3.0",
		"@fastify/compress": "^8.1.0",
		"@fastify/helmet": "^13.0.1",
		"@fastify/multipart": "^9.0.3",
		"@keyv/redis": "^4.4.0",
		"@nestjs/axios": "^4.0.1",
		"@nestjs/bullmq": "^11.0.3",
		"@nestjs/cache-manager": "^3.0.1",
		"@nestjs/common": "^11.1.6",
		"@nestjs/config": "^4.0.2",
		"@nestjs/core": "^11.1.6",
		"@nestjs/event-emitter": "^3.0.1",
		"@nestjs/jwt": "^11.0.0",
		"@nestjs/mapped-types": "^2.1.0",
		"@nestjs/mongoose": "^11.0.3",
		"@nestjs/passport": "^11.0.5",
		"@nestjs/platform-fastify": "^11.1.6",
		"@nestjs/platform-socket.io": "^11.1.6",
		"@nestjs/schedule": "^6.0.0",
		"@nestjs/throttler": "^6.4.0",
		"@nestjs/typeorm": "^11.0.0",
		"@nestjs/websockets": "^11.1.6",
		"@sentry/cli": "^2.39.1",
		"@sentry/nestjs": "^8.46.0",
		"@sentry/profiling-node": "^8.46.0",
		"@willsoto/nestjs-prometheus": "^6.0.2",
		"axios": "^1.7.7",
		"bcrypt": "^5.1.1",
		"body-parser": "^1.20.3",
		"bullmq": "^5.34.10",
		"cache-manager": "^7.0.0",
		"class-transformer": "^0.5.1",
		"csv-parser": "^3.2.0",
		"date-fns": "^3.6.0",
		"dotenv": "^16.4.5",
		"exceljs": "^4.4.0",
		"fastify": "^5.4.0",
		"fastify-sse": "^1.0.0",
		"flat": "^6.0.1",
		"fs-extra": "^11.3.0",
		"ioredis": "^5.4.1",
		"lodash": "^4.17.21",
		"lz-string": "^1.5.0",
		"mongoose": "^8.10.0",
		"mongoose-delete": "^1.0.2",
		"mongoose-paginate-v2": "^1.9.0",
		"morgan": "^1.10.0",
		"mssql": "^10.0.4",
		"nestjs-i18n": "^10.4.5",
		"nestjs-pino": "^4.4.0",
		"passport": "^0.7.0",
		"passport-jwt": "^4.0.1",
		"passport-local": "^1.0.0",
