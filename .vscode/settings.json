{
	"files.readonlyInclude": {
		"**/i18n.generated.ts": true,
		"pnpm-lock.yaml": true
	},
	"files.watcherExclude": {
		"**/i18n.generated.ts": true,
		"pnpm-lock.yaml": true
	},
	"search.exclude": {
		"**/i18n.generated.ts": true,
		"pnpm-lock.yaml": true
	},
	"[yaml]": {
		"editor.defaultFormatter": "redhat.vscode-yaml"
	}
}
