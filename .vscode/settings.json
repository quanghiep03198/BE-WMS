{
	"files.readonlyInclude": {
		"**/i18n.generated.ts": true,
		"pnpm-lock.yaml": true
	},
	"files.watcherExclude": {
		"**/i18n.generated.ts": true,
		"pnpm-lock.yaml": true,
		"**/.git/objects/**": true,
		"**/node_modules/**": true
	},
	"search.exclude": {
		"**/i18n.generated.ts": true,
		"pnpm-lock.yaml": true
	},
	"[yaml]": {
		"editor.defaultFormatter": "redhat.vscode-yaml"
	}
}
