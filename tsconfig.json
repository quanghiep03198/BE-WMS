{
	"compilerOptions": {
		"types": ["@rspack/core/module", "node", "jest"],
		"module": "esnext",
		"moduleResolution": "bundler",
		"declaration": true,
		"removeComments": true,

		"emitDecoratorMetadata": true,
		"experimentalDecorators": true,
		"allowSyntheticDefaultImports": true,
		"lib": ["ESNext"],
		"target": "es2021",
		"sourceMap": true,
		"outDir": "./dist",
		"incremental": true,
		/* Strict mode */
		/* Most of strict mode options are disabled because of slow startup */
		"strict": true,
		"skipLibCheck": false,
		"strictNullChecks": false,
		"strictBindCallApply": true,
		"noUnusedParameters": false,
		"noUnusedLocals": false,
		"noImplicitAny": false,
		"forceConsistentCasingInFileNames": true,
		"noFallthroughCasesInSwitch": true,
		/* Path alias */
		"sourceRoot": "/",
		"ignoreDeprecations": "6.0",
		"paths": {
			// "@/*": ["./src/*"],
			"@common/*": ["./src/common/*"],
			"@configs/*": ["./src/configs/*"],
			"@databases/*": ["./src/databases/*"],
			"@generated/*": ["./src/generated/*"],
			"@modules/*": ["./src/modules/*"],
			"@redis/*": ["./src/redis/*"],
			"@tasks/*": ["./src/tasks/*"]
		},
		"inlineSources": true
	},
	"include": ["src", "test", "global.d.ts"],
	"exclude": ["node_modules", "dist", "deprecated", ".tmp", "src/**/.tmp/*"]
}
