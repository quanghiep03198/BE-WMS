{
	"$schema": "https://json.schemastore.org/nest-cli",
	"collection": "@nestjs/schematics",
	"sourceRoot": "src",
	"compilerOptions": {
		"assets": [
			{
				"include": "i18n/**/*",
				"watchAssets": true
			}
		],
		"deleteOutDir": true,
		"builder": {
			"type": "swc",
			"options": {
				"stripLeadingPaths": true,
				"swcrcPath": "infrastructure/.swcrc"
			}
		},
		"typeCheck": true,
		"tsConfigPath": "tsconfig.build.json"
	}
}
